{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortImports": {
    "partitionByComment": true,
    "customGroups": [
      {
        "groupName": "project-aliases",
        "elementNamePattern": [
          "entities",
          "entities/**",
          "core",
          "core/**",
          "store",
          "store/**",
          "agent",
          "agent/**",
          "gate",
          "gate/**",
          "host",
          "host/**",
          "ui",
          "ui/**",
          "runtime",
          "runtime/**",
          "infrastructure",
          "infrastructure/**",
        ],
      },
    ],
    "groups": [
      "builtin",
      "external",
      "project-aliases",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown",
    ],
  },
  "ignorePatterns": ["design", "design-prompts", "docs", "src/host/session/fixtures"],
  "overrides": [
    {
      // Every .tsx file in this project opens with a `/** @jsxImportSource ... */`
      // pragma that must stay the file's first line. Import-sorting can hoist a
      // later import above it, silently breaking JSX resolution, so import
      // reordering is disabled for .tsx; formatting still applies.
      "files": ["**/*.tsx"],
      "options": {
        "sortImports": false,
      },
    },
  ],
}
